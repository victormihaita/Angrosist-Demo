# Root .env for docker-compose overrides (optional — sane defaults exist in
# docker-compose.yml). Copy to .env to customize. NEVER put real secrets here;
# backend secrets live in backend/.env (gitignored).

# Local Postgres (used by the db, migrate, and backend services).
POSTGRES_USER=angrosist
POSTGRES_PASSWORD=angrosist
POSTGRES_DB=angrosist

# Backend CORS allowlist ("*" is fine for local; lock down for real deploys).
CORS_ALLOWED_ORIGINS=*

# Backend URL baked into the frontend build (the browser calls this from the host).
VITE_API_URL=http://localhost:8080
