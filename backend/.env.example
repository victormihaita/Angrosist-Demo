# Backend environment — copy to .env and fill in. NEVER commit real values.
# (.env is gitignored. In production these come from Secret Manager.)

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (Neon for demo; Cloud SQL in prod).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- LLM (demo: Gemini; prod: Claude behind the LLM port) -----------------
# Selects which LLM adapter is wired behind the ports.LLM seam. Both adapters
# implement the same interface, so this is a pure config switch. "gemini" is the
# default (keeps the demo working without an Anthropic key); set "claude" for the
# production provider.
LLM_PROVIDER=gemini

# Gemini (demo provider).
GEMINI_API_KEY=
# Model name is configuration, not hardcoded. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Claude / Anthropic (production provider). Used only when LLM_PROVIDER=claude.
# The SDK reads ANTHROPIC_API_KEY from the environment automatically.
ANTHROPIC_API_KEY=
# Model name is configuration, not hardcoded. Defaults to claude-haiku-4-5,
# the recommended high-volume qualification model (see AI_AGENT_SPEC §9).
CLAUDE_MODEL=claude-haiku-4-5
# Max output tokens per turn. Qualification replies are short; defaults to 1024.
CLAUDE_MAX_TOKENS=1024

# --- Company verification (DemoANAF / ANAF) -------------------------------
# Selects the adapter behind the CompanyDataProvider port. Both implement the
# same interface, so this is a pure config switch (see docs/specs/ANAF_API.md).
#   demoanaf (default) — richer DemoANAF REST API (ONRC reg number,
#                        administrators, full CAEN list, derived roles[]).
#                        Recommended for production.
#   anaf               — raw ANAF VAT-payer web service (VAT + basic name/
#                        address only). Kept as a resilience FALLBACK.
ANAF_PROVIDER=demoanaf

# DemoANAF REST base URL (used when ANAF_PROVIDER=demoanaf). Never hardcoded.
DEMOANAF_BASE_URL=https://demoanaf.ro/api

# Raw-ANAF VAT-payer base URL (used when ANAF_PROVIDER=anaf, the fallback).
# Documented here for completeness; the raw client defaults to this if unset.
# ANAF_VAT_BASE_URL=https://webservicesp.anaf.ro/api/PlatitorTvaRest/v9/tva

# Set to true to skip real network calls and return deterministic demo data.
# Honored by either provider — useful to run the demo without the external dep.
ANAF_DEMO_MODE=false

# --- Async agent-turn runtime (M2 Epic 2.2) -------------------------------
# Selects the Queue adapter behind the ports.Queue seam.
#   local      (default) — runs the turn processor in-process (a goroutine) so
#                          the demo / docker compose work without external infra.
#   cloudtasks            — pushes turn jobs as JSON POSTs to the worker URL for
#                          durable async processing (production; provisioning
#                          of the managed Cloud Tasks queue is deferred).
QUEUE_PROVIDER=local

# Worker push target. Required only when QUEUE_PROVIDER=cloudtasks: the absolute
# URL of cmd/worker's turn endpoint (e.g. https://worker-xxx.run.app/worker/turn).
WORKER_URL=

# Optional Bearer token sent on the push request so the worker can authenticate
# Cloud Tasks. Comes from Secret Manager in prod; leave empty locally.
WORKER_AUTH_TOKEN=

# Optional push-request timeout in seconds for the cloudtasks adapter (default 10).
QUEUE_PUSH_TIMEOUT_SECONDS=

# Port cmd/worker listens on (Cloud Tasks push target). Falls back to PORT, then
# 8081. The API server (cmd/server) and the worker run as separate processes.
WORKER_PORT=8081

# --- Staff/admin auth + RBAC (M3 Epic 3.3) --------------------------------
# HMAC signing secret for staff session JWTs (HS256). REQUIRED: the server fails
# fast on startup and /api/auth/login cannot issue tokens if this is empty. There
# is intentionally no dev default. Generate a long random value; in prod it comes
# from Secret Manager. e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Optional admin bootstrap. When BOTH are set, startup idempotently upserts an
# admin user with this email and a bcrypt hash of this password (never stored or
# logged in plaintext). Leave empty to skip. Set once to seed the first admin,
# then rotate the password via the dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Transactional email (M3 Epic 3.4) ------------------------------------
# Selects the Mailer adapter behind the ports.Mailer seam.
#   log  (default) — renders templates and logs a non-PII summary instead of
#                    sending, so docker compose / tests / the demo need no SMTP.
#   smtp           — delivers over SMTP+STARTTLS. Any EU provider that speaks
#                    SMTP (Brevo/Mailgun/SendGrid) works through the vars below;
#                    no vendor SDK is added.
MAIL_PROVIDER=log

# SMTP settings (used only when MAIL_PROVIDER=smtp). Secrets come from Secret
# Manager in prod; leave empty locally. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From header/envelope address for outbound mail (required for smtp).
MAIL_FROM=

# Staff inbox that receives internal lead notifications + handoff alerts. Empty
# disables staff email (prospect confirmations still send).
STAFF_NOTIFY_EMAIL=

# Default email language ("ro" | "en") when the contact's language is unknown.
DEFAULT_LANG=ro

# --- GDPR consent + erasure (M5) ------------------------------------------
# Consent text/version recorded on every consent capture (consents.text_version,
# SECURITY.md §7.1). Bump this string whenever the consent wording changes so the
# captured proof records which version the subject agreed to. Defaults to "v1"
# when unset. The right-to-erasure cascade is admin-only (POST /api/gdpr/erasure).
# CONSENT_TEXT_VERSION=v1

# --- HTTP server ----------------------------------------------------------
# Port the local server listens on (default 8080).
PORT=8080
# Comma-separated CORS allowlist. "*" allows any origin (needed for the public
# embeddable widget). For the dashboard in prod, set explicit origins, e.g.
# https://app.eurointermed.ro,https://dashboard.eurointermed.ro
CORS_ALLOWED_ORIGINS=*

# --- File storage / uploads (M3 Epic 3.2) ---------------------------------
# FileStore provider behind the ports.FileStore seam:
#   local (default) — internal/storage/localfs; writes under FILESTORE_DIR and
#                     serves bytes via GET /uploads/{key}. Runs in docker/local.
#   gcs             — internal/storage/gcs; DEFERRED to provisioning (fails loudly
#                     until the real signed-URL adapter + private bucket land).
FILESTORE_PROVIDER=local
# Root directory for the local FileStore (default ./_uploads). Use a mounted
# volume in docker compose; never on instance disk in prod (prod uses GCS).
# FILESTORE_DIR=./_uploads
# Private GCS bucket (europe-* for EU residency), used only when FILESTORE_PROVIDER=gcs.
# GCS_BUCKET=
# Max bytes for a single upload (default ~10MiB = 10485760). Enforced via
# http.MaxBytesReader on POST /api/upload and POST /api/conversations/{id}/photos.
# MAX_UPLOAD_BYTES=10485760
# Max photos a single (public, unauthenticated) PalletClearance seller conversation
# may upload via POST /api/conversations/{id}/photos (default 10). Abuse limit on
# the public seller-photo endpoint that backs the seller-photo blocking gate.
# MAX_PHOTOS_PER_CONVERSATION=10

# --- WhatsApp Cloud API channel (M4 part C) -------------------------------
# The WhatsApp channel is INERT until ALL of the below are set AND the Meta
# Business / number is verified (owner action). The webhook routes
# (GET/POST /api/webhooks/whatsapp) are always registered and the POST signature
# is always enforced, but with no token/phone-number-id the outbound sender is a
# no-op (Send returns ErrNotConfigured) and the whatsapp reply channel is not
# registered. Set these only when going live; in prod they come from Secret
# Manager, never committed. Leave commented for local/demo.
#
# Graph API base (optional; defaults to a pinned Graph version in the adapter).
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# Cloud API access token (Bearer) for outbound sends. SECRET.
# WHATSAPP_TOKEN=
# Sending phone number id (forms the {id}/messages endpoint path).
# WHATSAPP_PHONE_NUMBER_ID=
# Token echoed back during the Meta GET subscription handshake (hub.verify_token).
# WHATSAPP_VERIFY_TOKEN=
# App secret keying the X-Hub-Signature-256 HMAC verified on every inbound POST. SECRET.
# WHATSAPP_APP_SECRET=
#
# DEFERRED (not built yet): 24h customer-service window tracking + the out-of-window
# re-engagement TEMPLATE send (FR-1.4). Today Send only delivers free-form text,
# which Meta accepts only inside the 24h window. Multi-vertical wa.me intent
# routing (FR-1.5) is also deferred — inbound WhatsApp defaults to angrosist/buy.
