# Backend environment — copy to .env and fill in. NEVER commit real values.
# (.env is gitignored. In production these come from Secret Manager.)

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (Neon for demo; Cloud SQL in prod).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- LLM (demo: Gemini; prod: Claude behind the LLM port) -----------------
# Selects which LLM adapter is wired behind the ports.LLM seam. Both adapters
# implement the same interface, so this is a pure config switch. "gemini" is the
# default (keeps the demo working without an Anthropic key); set "claude" for the
# production provider.
LLM_PROVIDER=gemini

# Gemini (demo provider).
GEMINI_API_KEY=
# Model name is configuration, not hardcoded. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Claude / Anthropic (production provider). Used only when LLM_PROVIDER=claude.
# The SDK reads ANTHROPIC_API_KEY from the environment automatically.
ANTHROPIC_API_KEY=
# Model name is configuration, not hardcoded. Defaults to claude-haiku-4-5,
# the recommended high-volume qualification model (see AI_AGENT_SPEC §9).
CLAUDE_MODEL=claude-haiku-4-5
# Max output tokens per turn. Qualification replies are short; defaults to 1024.
CLAUDE_MAX_TOKENS=1024

# --- Company verification (DemoANAF / ANAF) -------------------------------
# NOTE: this currently points at the raw ANAF VAT-payer service. M1 repoints
# the adapter to https://demoanaf.ro/api (richer data). See docs/specs/ANAF_API.md.
DEMOANAF_BASE_URL=https://webservicesp.anaf.ro/api/PlatitorTvaRest/v9/tva
# Set to true to skip real ANAF calls and return demo company data.
ANAF_DEMO_MODE=false

# --- Async agent-turn runtime (M2 Epic 2.2) -------------------------------
# Selects the Queue adapter behind the ports.Queue seam.
#   local      (default) — runs the turn processor in-process (a goroutine) so
#                          the demo / docker compose work without external infra.
#   cloudtasks            — pushes turn jobs as JSON POSTs to the worker URL for
#                          durable async processing (production; provisioning
#                          of the managed Cloud Tasks queue is deferred).
QUEUE_PROVIDER=local

# Worker push target. Required only when QUEUE_PROVIDER=cloudtasks: the absolute
# URL of cmd/worker's turn endpoint (e.g. https://worker-xxx.run.app/worker/turn).
WORKER_URL=

# Optional Bearer token sent on the push request so the worker can authenticate
# Cloud Tasks. Comes from Secret Manager in prod; leave empty locally.
WORKER_AUTH_TOKEN=

# Optional push-request timeout in seconds for the cloudtasks adapter (default 10).
QUEUE_PUSH_TIMEOUT_SECONDS=

# Port cmd/worker listens on (Cloud Tasks push target). Falls back to PORT, then
# 8081. The API server (cmd/server) and the worker run as separate processes.
WORKER_PORT=8081

# --- HTTP server ----------------------------------------------------------
# Port the local server listens on (default 8080).
PORT=8080
# Comma-separated CORS allowlist. "*" allows any origin (needed for the public
# embeddable widget). For the dashboard in prod, set explicit origins, e.g.
# https://app.eurointermed.ro,https://dashboard.eurointermed.ro
CORS_ALLOWED_ORIGINS=*
